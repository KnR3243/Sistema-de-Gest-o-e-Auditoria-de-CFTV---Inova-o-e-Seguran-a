/**
 * SISTEMA SCD - BACKEND COMPLETO E DEFINITIVO
 * Versão: Geração de PDF, Login, CRUD de Câmeras e Histórico
 */

const LOGO_ICC_BASE64 = "data:image/png;base64,";

// Função para garantir que a resposta seja sempre JSON e nunca quebre o Vercel
function responder(obj) {
  return ContentService.createTextOutput(JSON.stringify(obj))
    .setMimeType(ContentService.MimeType.JSON);
}

function doGet(e) {
  try {
    const planilha = SpreadsheetApp.getActiveSpreadsheet();
    const acao = e.parameter ? e.parameter.acao : null;

    // 1. CARREGAR AS CÂMERAS DA PLANILHA "Camêras"
    if (acao === 'getCameras') {
      const abaCam = planilha.getSheetByName("Camêras"); 
      if (!abaCam) return responder({ erro: "Aba Camêras não encontrada" });
      
      const dados = abaCam.getDataRange().getValues();
      const resultado = [];
      for (let i = 1; i < dados.length; i++) {
        if(dados[i][0]) { 
          resultado.push({
            unidade: dados[i][0].toString().trim(),
            nome: dados[i][1].toString().trim(),
            nvr: dados[i][2].toString().trim(),
            local: dados[i][3] ? dados[i][3].toString().trim() : "",
            status: dados[i][4] ? dados[i][4].toString().trim() : "Online",
            rowId: i + 1 // Essencial para edição e exclusão
          });
        }
      }
      return responder(resultado);
    }

    // 2. CARREGAR O HISTÓRICO DA PLANILHA "Checklists"
    if (acao === 'getHistory' || !acao) {
      const abaChecklists = planilha.getSheetByName("Checklists");
      if(!abaChecklists) return responder([]);
      
      const dadosChecklist = abaChecklists.getDataRange().getValues();
      if(dadosChecklist.length <= 1) return responder([]);
      
      const cabecalho = dadosChecklist[0];
      const linhas = dadosChecklist.slice(1);
      
      const formatarData = (data) => {
        if (!data) return "";
        if (data instanceof Date) return Utilities.formatDate(data, "America/Sao_Paulo", "dd/MM/yyyy");
        return data;
      };
      
      const formatarHora = (hora) => {
        if (!hora) return "";
        if (hora instanceof Date) return Utilities.formatDate(hora, "America/Sao_Paulo", "HH:mm:ss");
        return hora;
      };

      const resultadoChecklist = linhas.map(linha => {
        let obj = {};
        cabecalho.forEach((col, i) => {
          if (col === "Data") obj[col] = formatarData(linha[i]);
          else if (col === "Horário" || col === "Horario") obj[col] = formatarHora(linha[i]);
          else obj[col] = linha[i];
        });
        return obj;
      });
      return responder(resultadoChecklist);
    }
    
    return responder({ erro: "Ação GET não reconhecida." });

  } catch(err) {
    return responder({ erro: err.toString() });
  }
}

function doPost(e) {
  try {
    const planilha = SpreadsheetApp.getActiveSpreadsheet();
    
    if (!e.postData || !e.postData.contents) {
      return responder({ sucesso: false, erro: "Nenhum dado enviado." });
    }
    
    const dados = JSON.parse(e.postData.contents);

    // --- LÓGICA DE LOGIN ---
    if (dados.acao === 'login') {
      const abaUsu = planilha.getSheetByName("Usuarios");
      if (!abaUsu) return responder({ sucesso: false, erro: "Aba Usuarios não encontrada" });
      
      const usuarios = abaUsu.getDataRange().getValues();
      for (let i = 1; i < usuarios.length; i++) {
        if (usuarios[i][0].toString().trim() === dados.usuario.toString().trim() && 
            usuarios[i][1].toString().trim() === dados.senha.toString().trim()) {
          return responder({
            sucesso: true,
            perfil: usuarios[i][2],
            email: usuarios[i][3] ? usuarios[i][3].toString().trim() : ""
          });
        }
      }
      return responder({ sucesso: false, erro: "Usuário ou senha inválidos" });
    }

    // --- ENVIO AUTOMÁTICO DE E-MAIL DO RELATÓRIO ---
    if (dados.acao === 'send_report_email') {
      return responder(enviarEmailRelatorioCameras_(dados));
    }
    // --- ADICIONAR NOVA CÂMERA ---
    if (dados.acao === 'add') {
      const abaCam = planilha.getSheetByName("Camêras");
      if (abaCam) {
        abaCam.appendRow([
          dados.unidade || "", 
          dados.nome || "", 
          dados.nvr || "", 
          dados.local || "", 
          dados.status || "online"
        ]);
        return responder({ sucesso: true });
      }
    }

    // --- EDITAR CÂMERA EXISTENTE ---
    if (dados.acao === 'edit') {
      const abaCam = planilha.getSheetByName("Camêras");
      if (abaCam && dados.rowId) {
        abaCam.getRange(Number(dados.rowId), 1, 1, 5).setValues([[
          dados.unidade || "", 
          dados.nome || "", 
          dados.nvr || "", 
          dados.local || "", 
          dados.status || "online"
        ]]);
        return responder({ sucesso: true });
      }
    }

    // --- EXCLUIR CÂMERA ---
    if (dados.acao === 'delete') {
      const abaCam = planilha.getSheetByName("Camêras");
      if (abaCam && dados.rowId) {
        abaCam.deleteRow(Number(dados.rowId)); // Força para ser número
        return responder({ sucesso: true });
      }
    }

    // --- LÓGICA DE GERAR PDF DO CHECKLIST ---
    if (dados.acao === 'add_checklist') {
      let urlPDF = "Sem anexo";

      try {
        let htmlDoPDF = `
          <div style="font-family: Arial, sans-serif; padding: 10px;">
            <div style="display: table; width: 100%; margin-bottom: 20px;">
              <div style="display: table-cell; vertical-align: middle; text-align: left; width: 20%;">
                <img src="${LOGO_ICC_BASE64}" style="width: 120px;">
              </div>
              <div style="display: table-cell; vertical-align: middle; text-align: center;">
                <h2 style="color: #2e7d32; margin: 0; padding-bottom: 10px; border-bottom: 2px solid #2e7d32; font-size: 18px;">RELATÓRIO DIÁRIO DE CHECKLIST - CÂMERAS</h2>
                <p style="margin: 5px 0 0 0; font-size: 10px; color: #666;">Sistema SCD - Monitoramento e Auditoria</p>
              </div>
              <div style="display: table-cell; width: 20%;"></div>
            </div>

            <table style="width: 100%; border-collapse: collapse; margin-bottom: 20px; font-size: 12px;">
              <tr>
                <th style="border: 1px solid #000; padding: 8px; background-color: #e5e7eb; text-align: left; width: 20%;">Data</th>
                <td style="border: 1px solid #000; padding: 8px; width: 30%;">${dados.data}</td>
                <th style="border: 1px solid #000; padding: 8px; background-color: #e5e7eb; text-align: left; width: 20%;">Horário</th>
                <td style="border: 1px solid #000; padding: 8px; width: 30%;">${dados.horario}</td>
              </tr>
              <tr>
                <th style="border: 1px solid #000; padding: 8px; background-color: #e5e7eb; text-align: left;">Responsável</th>
                <td style="border: 1px solid #000; padding: 8px;">${dados.responsavel}</td>
                <th style="border: 1px solid #000; padding: 8px; background-color: #e5e7eb; text-align: left;">Unidade</th>
                <td style="border: 1px solid #000; padding: 8px;">${dados.unidade}</td>
              </tr>
            </table>
            
            ${dados.htmlTabelaCameras}

            <div style="margin-top: 40px; text-align: center; page-break-inside: avoid;">
              <img src="${dados.assinaturaB64}" style="height: 70px;">
              <p style="font-size: 12px; font-weight: bold; margin-top: 5px;">Assinatura do Responsável</p>
            </div>
          </div>
        `;

        let blobPDF = Utilities.newBlob(htmlDoPDF, MimeType.HTML).getAs(MimeType.PDF);
        let nomeArquivo = "Checklist_" + dados.unidade + "_" + dados.data.split('/').join('-') + ".pdf";
        blobPDF.setName(nomeArquivo);

        let pastas = DriveApp.getFoldersByName("SCD_Checklists_PDFs");
        let pastaAlvo = pastas.hasNext() ? pastas.next() : DriveApp.createFolder("SCD_Checklists_PDFs");
        urlPDF = pastaAlvo.createFile(blobPDF).getUrl();
        
      } catch(erroDrive) {
        urlPDF = "Erro na geração do PDF: " + erroDrive.toString();
      }

      const abaChecklists = planilha.getSheetByName("Checklists");
      if (abaChecklists) {
        abaChecklists.appendRow([
          dados.data,
          dados.horario,
          dados.responsavel,
          dados.unidade,
          dados.ocorrencias,
          urlPDF
        ]);
        return responder({ sucesso: true, linkDoc: urlPDF });
      }
    }
    
    return responder({ sucesso: false, erro: "Ação POST não reconhecida." });

  } catch(e) {
    return responder({ sucesso: false, erro: e.toString() });
  }
}
/**
 * ENVIO AUTOMÁTICO DE E-MAIL DO RELATÓRIO DE CÂMERAS
 * Usado pela ação POST: send_report_email
 */
function enviarEmailRelatorioCameras_(dados) {
  try {
    var destinatario = String(dados.destinatario || dados.emailDestino || "").trim();
    if (!destinatario || destinatario.indexOf("@") === -1) {
      return {
        sucesso: false,
        erro: "Destinatário de e-mail inválido. Verifique a coluna email na aba Usuarios."
      };
    }

    var assunto = String(dados.assunto || "Relatório de Câmeras").trim();
    var mensagem = String(dados.mensagem || "").trim();
    var linkDoc = String(dados.linkDoc || "").trim();
    var unidade = String(dados.unidade || "").trim();
    var data = String(dados.data || "").trim();
    var horario = String(dados.horario || "").trim();
    var responsavel = String(dados.responsavel || "").trim();
    var resumo = String(dados.resumo || "").trim();

    if (!mensagem) {
      mensagem = [
        "Olá " + (responsavel || ""),
        "",
        "Segue o relatório de verificação das câmeras" + (unidade ? " da unidade " + unidade : "") + ".",
        "",
        data || horario ? "Data/Hora: " + data + (horario ? " às " + horario : "") : "",
        responsavel ? "Responsável: " + responsavel : "",
        resumo ? "Resumo: " + resumo : "",
        linkDoc ? "PDF do relatório: " + linkDoc : "",
        "",
        "Atenciosamente",
        "Equipe de TI"
      ].filter(Boolean).join("\n");
    }

    var htmlBody = mensagem
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/\n/g, "<br>");

    var opcoes = {
      to: destinatario,
      subject: assunto,
      body: mensagem,
      htmlBody: htmlBody,
      name: "Gestão de Câmeras - ICC"
    };

    var anexoPdf = obterAnexoPdfDoDrive_(linkDoc);
    if (anexoPdf) {
      opcoes.attachments = [anexoPdf];
    }

    MailApp.sendEmail(opcoes);

    return {
      sucesso: true,
      sent: true,
      mensagem: "E-mail enviado com sucesso.",
      anexoPdf: Boolean(anexoPdf)
    };
  } catch (erro) {
    return {
      sucesso: false,
      erro: erro && erro.message ? erro.message : String(erro)
    };
  }
}

function obterAnexoPdfDoDrive_(linkDoc) {
  var fileId = extrairIdArquivoDrive_(linkDoc);
  if (!fileId) return null;

  try {
    var arquivo = DriveApp.getFileById(fileId);
    var blob = arquivo.getBlob();

    if (blob.getContentType() !== MimeType.PDF) {
      blob = arquivo.getAs(MimeType.PDF);
    }

    return blob.setName(arquivo.getName().replace(/\.pdf$/i, "") + ".pdf");
  } catch (erro) {
    return null;
  }
}

function extrairIdArquivoDrive_(url) {
  if (!url) return "";

  var texto = String(url);
  var match = texto.match(/\/d\/([a-zA-Z0-9_-]+)/);
  if (match && match[1]) return match[1];

  match = texto.match(/[?&]id=([a-zA-Z0-9_-]+)/);
  if (match && match[1]) return match[1];

  return "";
}

/**
 * OPCIONAL: rode esta função uma vez no editor do Apps Script
 * para o Google solicitar as permissões de envio de e-mail.
 */
function autorizarEnvioEmail() {
  var email = Session.getActiveUser().getEmail();
  if (!email) {
    throw new Error("Não foi possível identificar o e-mail do usuário ativo.");
  }

  MailApp.sendEmail({
    to: email,
    subject: "Teste de autorização - Gestão de Câmeras",
    body: "Se você recebeu este e-mail, o Apps Script está autorizado a enviar relatórios.",
    name: "Gestão de Câmeras - ICC"
  });
}

