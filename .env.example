G_SCRIPT_URL=https://script.google.com/macros/s/COLE_A_URL_DA_API_AQUI/exec

# Configuração administrativa do NVR. Nunca coloque estas informações na tela do operador.
# A API local do NVR usa a porta HTTP; a porta 37777 continua sendo interna ao equipamento.
NVR_API_HOST=192.168.30.10
NVR_API_NAME=NVR 01
NVR_API_PORT=80
NVR_API_PROTOCOL=http
NVR_API_USER=COLOQUE_O_USUARIO_DO_NVR
NVR_API_PASSWORD=COLOQUE_A_SENHA_DO_NVR
NVR_API_TIMEOUT_MS=6000

# Segundo NVR (opcional). Usuário e senha repetem os do NVR 01 se ficarem em branco.
NVR_2_HOST=192.168.30.11
NVR_2_NAME=NVR 02
NVR_2_PORT=80
# NVR_2_USER=COLOQUE_OUTRO_USUARIO_SE_NECESSARIO
# NVR_2_PASSWORD=COLOQUE_OUTRA_SENHA_SE_NECESSARIO
